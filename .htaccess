# .htaccess para sofomes.com - CodeIgniter 4
# Shared hosting: DocumentRoot = raíz del proyecto (no public/)
# Este archivo redirige todo a public/index.php

RewriteEngine On

# ─── RewriteBase dinámico ────────────────────────────────────────────
# Producción (sofomes.com): raíz /
RewriteCond %{HTTP_HOST} ^(www\.)?sofomes\.com$ [NC]
RewriteRule ^ - [E=BASE:/]

# Local (cualquier otro host): /sofomes.com/
RewriteCond %{HTTP_HOST} !^(www\.)?sofomes\.com$ [NC]
RewriteRule ^ - [E=BASE:/sofomes.com/]

# ─── Redirecciones de producción ─────────────────────────────────────
# Forzar HTTPS
RewriteCond %{HTTP_HOST} ^(www\.)?sofomes\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → non-www
RewriteCond %{HTTP_HOST} ^www\.sofomes\.com$ [NC]
RewriteRule ^(.*)$ https://sofomes.com/$1 [L,R=301]

# ─── Redirects 301: legacy .php URLs ────────────────────────────────
# Remove .php extension from old indexed URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ─── Servir archivos estáticos desde public/ ─────────────────────────
# Si el archivo existe en public/, servirlo directamente
RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
RewriteRule ^(.*)$ public/$1 [L]

# Si el directorio existe en public/, servirlo
RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# ─── Todo lo demás va al front controller CI4 ───────────────────────
RewriteRule ^(.*) public/index.php/$1 [L]

# ─── Prevenir listado de directorios ────────────────────────────────
Options -Indexes +FollowSymLinks

# ─── Bloquear acceso directo a directorios CI4 ──────────────────────
# Proteger app/, writable/, vendor/, system/
RedirectMatch 403 ^/app/
RedirectMatch 403 ^/writable/
RedirectMatch 403 ^/vendor/
RedirectMatch 403 ^/system/

# ─── Bloquear archivos sensibles ────────────────────────────────────
<FilesMatch "\.(env|log|bak|sql|config|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ─── Headers de seguridad ───────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Compresión GZIP ───────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# ─── Cache para recursos estáticos ─────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/json          "access plus 1 day"
    ExpiresByType application/pdf           "access plus 1 month"
</IfModule>

# Disable server signature
ServerSignature Off
