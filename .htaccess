# .htaccess para sofomes.com
# Generado: 2025-10-28

# Habilitar engine de reescritura
RewriteEngine On
RewriteBase /sofomes.com/

# Página de inicio predeterminada (PHP primero, HTML como fallback)
DirectoryIndex index.php index.html

# Habilitar seguimiento de enlaces simbólicos
Options +FollowSymLinks

# Prevenir listado de directorios
Options -Indexes

# Permitir acceso a archivos CSS, JS, imágenes
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|eot|ico|pdf|txt|xml)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

# Permitir acceso a archivos HTML y PHP
<FilesMatch "\.(html|htm|php)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

# Configuración de tipos MIME
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
AddType application/x-font-woff .woff
AddType application/x-font-woff2 .woff2

# Habilitar compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Seguridad: Bloquear acceso a archivos sensibles
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bloquear acceso a archivos de configuración
<FilesMatch "\.(env|log|bak|sql|config)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Redirección para directorio raíz (con o sin barra final)
RewriteCond %{REQUEST_URI} ^/sofomes\.com/?$
RewriteRule ^ /sofomes.com/index.php [L]

# Redirecciones 301: HTML → PHP (mantener SEO) - SOLO EN PRODUCCIÓN
RewriteCond %{HTTP_HOST} ^(www\.)?sofomes\.com$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)\.html$ /$1.php [L,R=301]

# URLs amigables: permitir acceso sin extensión
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# Redirección HTTPS (forzar SSL) - SOLO EN PRODUCCIÓN
RewriteCond %{HTTP_HOST} ^(www\.)?sofomes\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirección www a non-www (versión canónica) - SOLO EN PRODUCCIÓN
RewriteCond %{HTTP_HOST} ^www\.sofomes\.com$ [NC]
RewriteRule ^(.*)$ https://sofomes.com/$1 [L,R=301]

# Errores personalizados (opcional)
# ErrorDocument 404 /404.html
# ErrorDocument 403 /403.html
# ErrorDocument 500 /500.html
